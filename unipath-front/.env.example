# URL de l'API backend (doit se terminer par /api)
VITE_API_URL=http://localhost:3001/api

# Tests E2E (Playwright) : npm run test:e2e
# Les tests mockent l'API — pas besoin du backend pour les lancer.

# Checklist :
# 1. L'API doit tourner sur le port 3001 (unipath-api)
# 2. APP_URL côté API = http://localhost:5173 (liens email)
# 3. Après modification : redémarrer npm run dev + Ctrl+F5

# Token Vercel (généré automatiquement par Vercel CLI)
# VERCEL_OIDC_TOKEN=your_token_here
