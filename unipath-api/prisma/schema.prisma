generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Candidat {
  id                           String                        @id @default(uuid())
  matricule                    String                        @unique
  nom                          String
  prenom                       String
  anip                         String?                       @unique
  serie                        String?
  sexe                         String?
  nationalite                  String?
  email                        String                        @unique
  emailConfirme                Boolean                       @default(false)
  telephone                    String?
  dateNaiss                    DateTime?
  lieuNaiss                    String?
  role                         Role                          @default(ETUDIANT)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  diplome                      Diplome?
  dossier                      Dossier?
  inscriptions                 Inscription[]
  InscriptionAcademique        InscriptionAcademique[]
  preinscriptionsEtablissement PreinscriptionEtablissement[]
  applications                 Application[]

  @@index([anip])
}

model MembreCommission {
  id        String             @id @default(uuid())
  nom       String
  prenom    String
  email     String             @unique
  telephone String?
  role      Role               @default(COMMISSION)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sousRole  SousRoleCommission @default(MEMBRE)

  @@index([sousRole])
}

model AdministrateurDGES {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  telephone String?
  role      Role     @default(DGES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Controleur {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  telephone String?
  role      Role     @default(CONTROLEUR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Concours {
  id                   String        @id @default(uuid())
  libelle              String
  etablissement        String?
  dateDebut            DateTime
  dateFin              DateTime
  dateComposition      DateTime?
  description          String?
  fraisParticipation   Int?
  seriesAcceptees      String[]      @default([])
  matieres             String[]      @default([])
  piecesRequises       Json?
  centresComposition   Json?
  dateDebutDepot       DateTime?
  dateFinDepot         DateTime?
  dateDebutComposition DateTime?
  dateFinComposition   DateTime?
  createdAt            DateTime      @default(now())
  criteresEligibilite  Json?
  inscriptions         Inscription[]

  @@index([dateDebutDepot])
  @@index([dateFinDepot])
}

model Inscription {
  id                 String              @id @default(uuid())
  numeroInscription  String?             @unique
  candidatId         String
  concoursId         String
  note               Float?
  createdAt          DateTime            @default(now())
  dossierInscription DossierInscription?
  candidat           Candidat            @relation(fields: [candidatId], references: [id])
  concours           Concours            @relation(fields: [concoursId], references: [id])

  @@unique([candidatId, concoursId])
  @@index([candidatId])
  @@index([concoursId])
}

model DossierInscription {
  id                      String          @id @default(uuid())
  inscriptionId           String          @unique
  quittanceUrl            String?
  piecesExtras            Json?
  statut                  StatutDossier   @default(EN_ATTENTE)
  verdict1Par             String?
  verdict1                Verdict?
  verdict1Motif           String?
  verdict1Date            DateTime?
  verdict1ModifieCount    Int             @default(0)
  verdict2Par             String?
  verdict2                Verdict?
  verdict2Motif           String?
  verdict2Date            DateTime?
  verdict2ModifieCount    Int             @default(0)
  decisionControleur      Verdict?
  decisionControleurMotif String?
  decisionControleurDate  DateTime?
  decisionControleurPar   String?
  commentaireRejet        String?
  commentaireSousReserve  String?
  documentsCompl          Json?
  historiqueStatuts       Json?
  decisionCommissionPar   String?
  decisionCommissionDate  DateTime?
  commentaireControleur   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  actionHistory           ActionHistory[]
  inscription             Inscription     @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@index([inscriptionId])
  @@index([statut])
  @@index([verdict1Par])
  @@index([verdict2Par])
  @@index([decisionControleurPar])
  @@index([createdAt])
}

model Dossier {
  id            String   @id @default(uuid())
  candidatId    String   @unique
  acteNaissance String?
  carteIdentite String?
  photo         String?
  releve        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  candidat      Candidat @relation(fields: [candidatId], references: [id])
}

model ActionHistory {
  id                   String             @id @default(uuid())
  utilisateurId        String
  typeAction           String
  details              Json?
  timestamp            DateTime           @default(now())
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  dossierInscriptionId String
  dossierInscription   DossierInscription @relation(fields: [dossierInscriptionId], references: [id], onDelete: Cascade)

  @@index([dossierInscriptionId])
  @@index([utilisateurId])
  @@index([timestamp])
  @@index([typeAction])
  @@index([dossierInscriptionId, timestamp(sort: Desc)])
  @@index([utilisateurId, timestamp(sort: Desc)])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  priority  PriorityLevel    @default(NORMAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  expiresAt DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@index([type])
  @@index([expiresAt])
}

model NotificationTemplate {
  id        String           @id @default(uuid())
  name      String           @unique
  type      NotificationType
  subject   String
  htmlBody  String
  textBody  String?
  variables Json
  isActive  Boolean          @default(true)
  isDefault Boolean          @default(false)
  createdBy String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type])
  @@index([isActive])
}

model EmailDelivery {
  id             String         @id @default(uuid())
  notificationId String?
  userId         String?
  recipient      String
  subject        String
  status         DeliveryStatus @default(PENDING)
  messageId      String?
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  bouncedAt      DateTime?
  errorMessage   String?
  smtpCode       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  htmlBody       String?
  textBody       String?
  attachments    Json?
  nextRetryAt    DateTime?

  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([createdAt, status])
}

model UserPreferences {
  id          String   @id @default(uuid())
  userId      String   @unique
  preferences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model NotificationAuditLog {
  id           String         @id @default(uuid())
  eventType    AuditEventType
  userId       String?
  actorId      String?
  resourceId   String?
  resourceType String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime       @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([actorId])
  @@index([timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
}

model SystemAlert {
  id         String        @id @default(uuid())
  type       AlertType
  severity   AlertSeverity
  title      String
  message    String
  data       Json?
  resolved   Boolean       @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([resolved])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
}

model Etablissement {
  id              String                        @id @default(uuid())
  nom             String
  type            TypeEtablissement
  ville           String
  createdAt       DateTime                      @default(now())
  adresse         String?
  email           String?                       @unique
  filieres        Filiere[]
  inscriptions    InscriptionAcademique[]
  preinscriptions PreinscriptionEtablissement[]
  admins          AdminEtablissement[]
  applications    Application[]
  campagnes       CampagneInscription[]
  requirements    SchoolRequirement[]
  matriculeFormat String?

  @@index([type])
  @@index([ville])
}

model Filiere {
  id              String                        @id @default(uuid())
  nom             String
  etablissementId String
  dureeAnnees     Int
  createdAt       DateTime                      @default(now())
  code            String                        @unique
  niveau          NiveauFiliere
  diplomes        Diplome[]
  etablissement   Etablissement                 @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  inscriptions    InscriptionAcademique[]
  preinscriptions PreinscriptionEtablissement[]
  applications    Application[]
  campagneFilieres CampagneFiliere[]
  sigle             String?
  matriculeCompteur Int                           @default(0)

  @@index([etablissementId])
  @@index([niveau])
}

model InscriptionAcademique {
  id                   String                       @id @default(uuid())
  candidatId           String
  etablissementId      String
  filiereId            String
  anneeAcademique      String
  createdAt            DateTime                     @default(now())
  niveau               Int
  statut               StatutInscriptionAcad        @default(EN_COURS)
  quittanceBancaire    String?
  quittanceSoumiseLe   DateTime?
  quittanceValideeLe   DateTime?
  matricule            String?                      @unique
  candidat             Candidat                     @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  etablissement        Etablissement                @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  filiere              Filiere                      @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  notes                Note[]
  preinscriptionSource PreinscriptionEtablissement?

  @@unique([candidatId, filiereId, anneeAcademique])
  @@index([candidatId])
  @@index([filiereId])
  @@index([etablissementId])
  @@index([anneeAcademique])
}

model PreinscriptionEtablissement {
  id                    String                            @id @default(uuid())
  numeroPreinscription  String                            @unique
  candidatId            String
  filiereId             String
  etablissementId       String
  anneeAcademique       String
  niveau                Int
  statut                StatutPreinscriptionEtablissement @default(EN_ATTENTE)
  commentaireAdmin      String?
  documentsCompl        Json?
  historiqueStatuts     Json?
  motifDecision         String?
  decidedAt             DateTime?
  decidedBy             String?
  inscriptionAcadId     String?                           @unique
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  candidat              Candidat                          @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  etablissement         Etablissement                     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  filiere               Filiere                           @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  inscriptionAcademique InscriptionAcademique?            @relation(fields: [inscriptionAcadId], references: [id])
  applicationSource     Application?

  @@unique([candidatId, filiereId, anneeAcademique])
  @@index([candidatId])
  @@index([etablissementId, statut])
  @@index([createdAt])
}

model Note {
  id                String                @id @default(uuid())
  inscriptionAcadId String
  matiere           String
  noteCC            Float?
  noteExamen        Float?
  noteMoyenne       Float?
  credits           Int
  semestre          Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  inscriptionAcad   InscriptionAcademique @relation(fields: [inscriptionAcadId], references: [id], onDelete: Cascade)

  @@index([inscriptionAcadId])
  @@index([semestre])
}

model Diplome {
  id              String      @id @default(uuid())
  candidatId      String      @unique
  type            TypeDiplome
  filiere         String
  filiereId       String?
  etablissement   String
  annee           String
  mention         Mention?
  createdAt       DateTime    @default(now())
  candidat        Candidat    @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  filiereRelation Filiere?    @relation(fields: [filiereId], references: [id])

  @@index([filiereId])
  @@index([type])
  @@index([annee])
}

enum StatutDossier {
  EN_ATTENTE
  VALIDE_PAR_COMMISSION
  REJETE_PAR_COMMISSION
  SOUS_RESERVE_PAR_COMMISSION
  VALIDE
  REJETE
  SOUS_RESERVE
}

enum Verdict {
  VALIDE
  REJETE
  SOUS_RESERVE
}

enum Role {
  CANDIDAT
  COMMISSION
  CONTROLEUR
  DGES
  ADMIN_ETABLISSEMENT
  ETUDIANT
}

enum SousRoleCommission {
  MEMBRE
  EXAMINATEUR
  CONTROLEUR
}

enum NotificationType {
  PRE_INSCRIPTION
  VALIDATION
  CONVOCATION
  REJET
  NOUVEAU_DOSSIER
  RAPPORT_HEBDO
  RAPPORT_MENSUEL
  SYSTEME
  ALERTE
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  EXPIRED
}

enum AuditEventType {
  NOTIFICATION_CREATED
  NOTIFICATION_SENT
  NOTIFICATION_DELIVERED
  NOTIFICATION_FAILED
  NOTIFICATION_READ
  NOTIFICATION_DELETED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  PREFERENCES_UPDATED
  DATA_ACCESSED
  RETRY_ATTEMPTED
  ALERT_CREATED
}

enum AlertType {
  HIGH_FAILURE_RATE
  QUEUE_OVERLOAD
  SMTP_ERROR
  DELIVERY_ISSUE
  SYSTEM_ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum Mention {
  PASSABLE
  ASSEZ_BIEN
  BIEN
  TRES_BIEN
  EXCELLENT
}

enum TypeEtablissement {
  PUBLIC
  PRIVE
}

enum NiveauFiliere {
  LICENCE
  MASTER
}

enum StatutInscriptionAcad {
  EN_COURS
  VALIDE
  REDOUBLANT
  ABANDONNE
  EN_ATTENTE_QUITTANCE
  QUITTANCE_SOUMISE
}

enum StatutPreinscriptionEtablissement {
  EN_ATTENTE
  VALIDE
  SOUS_RESERVE
  REJETE
}

enum TypeDiplome {
  LICENCE
  MASTER
}

model AdminEtablissement {
  id              String        @id @default(uuid())
  nom             String
  prenom          String
  email           String        @unique
  telephone       String?
  role            Role          @default(ADMIN_ETABLISSEMENT)
  etablissementId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@index([etablissementId])
}

model Application {
  id                String                       @id @default(uuid())
  numeroApplication String                       @unique
  candidatId        String
  etablissementId   String
  filiereId         String
  anneeAcademique   String
  niveau            Int
  status            ApplicationStatus            @default(DRAFT)
  preinscriptionId  String?                      @unique
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  candidat          Candidat                     @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  etablissement     Etablissement                @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  filiere           Filiere                      @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  preinscription    PreinscriptionEtablissement? @relation(fields: [preinscriptionId], references: [id])
  documents         ApplicationDocument[]
  payments          Payment[]
  receipts          Receipt[]

  @@unique([candidatId, filiereId, anneeAcademique])
  @@index([candidatId])
  @@index([createdAt])
  @@index([etablissementId, status])
}

model ApplicationDocument {
  id                  String               @id @default(uuid())
  applicationId       String
  schoolRequirementId String?
  code                String
  label               String
  source              ApplicationDocSource
  documentUrl         String?
  status              ApplicationDocStatus @default(PENDING)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  application         Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  schoolRequirement   SchoolRequirement?   @relation(fields: [schoolRequirementId], references: [id])

  @@unique([applicationId, code])
  @@index([applicationId])
}

model SchoolRequirement {
  id              String                @id @default(uuid())
  etablissementId String
  code            String
  label           String
  requirementType RequirementType
  profileFieldKey String?
  isRequired      Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  etablissement   Etablissement         @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  documents       ApplicationDocument[]

  @@unique([etablissementId, code])
  @@index([etablissementId])
}

model Payment {
  id              String        @id @default(uuid())
  applicationId   String
  paymentType     PaymentType
  amount          Int
  currency        String        @default("XOF")
  paymentProvider String?
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(PENDING)
  externalRef     String?
  providerPayload Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  receipt         Receipt?

  @@index([applicationId, paymentType])
  @@index([status])
}

model Receipt {
  id            String      @id @default(uuid())
  paymentId     String?     @unique
  applicationId String
  receiptNumber String      @unique
  receiptType   ReceiptType
  receiptUrl    String?
  issuedAt      DateTime    @default(now())
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payment       Payment?    @relation(fields: [paymentId], references: [id])

  @@index([applicationId, receiptType])
}

model CampagneInscription {
  id              String            @id @default(uuid())
  etablissementId String
  titre           String
  anneeAcademique String
  dateOuverture   DateTime
  dateCloture     DateTime
  description     String?
  statut          StatutCampagne    @default(BROUILLON)
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  filieres        CampagneFiliere[]

  @@index([dateCloture])
  @@index([dateOuverture])
  @@index([etablissementId, statut])
}

model CampagneFiliere {
  id                String              @id @default(uuid())
  campagneId        String
  filiereId         String
  fraisDossier      Int
  placesDisponibles Int?
  criteresSelection String?
  seriesAcceptees   String[]            @default([])
  niveauMinBac      String?
  autresCriteres    Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  campagne          CampagneInscription @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  filiere           Filiere             @relation(fields: [filiereId], references: [id], onDelete: Cascade)

  @@unique([campagneId, filiereId])
  @@index([campagneId])
  @@index([filiereId])
}

enum ApplicationStatus {
  DRAFT
  DOSSIER_FEES_PAID
  PENDING_DOCUMENTS
  READY_FOR_PREINSCRIPTION
  FICHE_GENERATED
}

enum ApplicationDocSource {
  PROFILE_AUTO
  STUDENT_UPLOAD
  SYSTEM_GENERATED
}

enum ApplicationDocStatus {
  PENDING
  PROVIDED
}

enum RequirementType {
  PROFILE_FIELD
  DOCUMENT_UPLOAD
}

enum PaymentType {
  DOSSIER_FEES
  DROITS_INSCRIPTION
}

enum PaymentMethod {
  PLATFORM_GATEWAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ReceiptType {
  DOSSIER_FEES_RECEIPT
  BANK_RECEIPT
  PREINSCRIPTION_FICHE
}

enum StatutCampagne {
  BROUILLON
  PUBLIEE
  CLOTUREE
  ANNULEE
}
