# =============================================================================
# UniPath API — Configuration locale (MySQL Laragon + auth JWT)
# =============================================================================
#
# 1. DATABASE_URL — MySQL Laragon
#    mysql://root:@localhost:3306/unipath
#    (adapter user/mot de passe si différent)
#
# 2. JWT_SECRET — clé secrète pour les tokens (obligatoire en production)
#
# 3. APP_URL / FRONTEND_URL — URL du front (ex: http://localhost:5173)
#
# 4. SMTP_* — optionnel ; EMAIL_QUEUE_ENABLED=false en dev sans mail
#
# 5. Front : unipath-front/.env → VITE_API_URL=http://localhost:3001/api
#
# Smoke test :
#   curl http://localhost:3001/health
#   npm run create-admins
#   npm run seed:concours-officiels
# =============================================================================

DATABASE_URL="mysql://root:@localhost:3306/unipath"
JWT_SECRET="changez-moi-en-production-avec-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN=7d
PORT=3001
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@unipath.bj
SMTP_FROM_NAME=UniPath

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

ACADEMIC_YEAR=2025-2026
EMAIL_QUEUE_ENABLED=false
EMAIL_RETRY_DELAYS=1,5,15,60,240
EMAIL_RATE_LIMIT_PER_USER=10
EMAIL_RATE_LIMIT_GLOBAL=100

SITE_CODE=UnP

PHP_EMAIL_SERVICE_URL=http://localhost:3001/php/EmailService.php

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

NOTIFICATION_QUEUE_CONCURRENCY=10
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RATE_LIMIT=100
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=http://localhost:5173
