# =============================================================================
# UniPath API — Checklist configuration (copier vers .env et remplir)
# =============================================================================
#
# 1. DATABASE_URL
#    - Préférer le pooler Supabase en mode SESSION (port 5432) — requis pour Prisma :
#      postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#    - NE PAS utiliser le port 6543 (transaction mode) : connexions instables / P1001 avec Prisma
#    - Ajouter en fin d'URL si coupures réseau : ?pgbouncer=true&connect_timeout=30&pool_timeout=30
#    - Si P1001 persistant : dashboard Supabase → réveiller le projet (plan free en pause)
#
# 1b. DIRECT_URL (migrations Prisma uniquement)
#    postgresql://postgres.[PROJECT]:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# 2. SUPABASE_URL + SUPABASE_ANON_KEY + SUPABASE_SERVICE_KEY
#    - Dashboard Supabase → Settings → API
#
# 3. APP_URL / FRONTEND_URL (confirmation email candidats — flux UniPath uniquement)
#    - URL exacte du front (ex: http://localhost:5173)
#    - Liens générés : {APP_URL}/auth/confirm?token={uuid}
#    - Doit correspondre à l'adresse où vous ouvrez le site (pas localhost si prod/LAN)
#    - Supabase Dashboard → Authentication → Providers → Email :
#      désactiver « Confirm email » (sinon un 2e mail /auth/callback inutile)
#
# 4. SMTP_* (ou EMAIL_QUEUE_ENABLED=false en dev sans envoi mail)
#
# 5. Front : unipath-front/.env → VITE_API_URL=http://localhost:3001/api
#
# Smoke test après démarrage :
#   curl http://localhost:3001/api/health
#   npm run seed:concours-officiels   (si DB joignable)
# =============================================================================

DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
PORT=3001
APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# SMTP Configuration (Email System)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@unipath.bj
SMTP_FROM_NAME=UniPath

# Legacy Email Configuration (deprecated - use SMTP_* instead)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# Application Configuration
ACADEMIC_YEAR=2025-2026

# Email Queue — mettre false en dev si SMTP non configuré
EMAIL_QUEUE_ENABLED=false
EMAIL_RETRY_DELAYS=1,5,15,60,240
EMAIL_RATE_LIMIT_PER_USER=10
EMAIL_RATE_LIMIT_GLOBAL=100

# PHP Email Service (legacy)
PHP_EMAIL_SERVICE_URL=http://localhost:3001/php/EmailService.php

# Redis Configuration (notifications — optionnel)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

NOTIFICATION_QUEUE_CONCURRENCY=10
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RATE_LIMIT=100
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=http://localhost:5173
